#!/bin/sh
# Re-vendor plutosvg and plutovg.
# Usage: tools/update-plutosvg <plutosvg-tag> <plutovg-tag>   e.g. v0.0.8 v1.3.3
#
# Downloads both GitHub release archives, records their SHA-256s and the
# commits their tags resolve to, copies the files listed in
# tools/plutosvg-files.txt and tools/plutovg-files.txt into src/vendor/,
# applies tools/patches/*.patch in order (paths relative to src/vendor/),
# and rewrites src/vendor/PROVENANCE and the project-owned src/zsg_vendor.h.
# Run from the package root, then tools/verify-vendor, tools/check-symbols
# and R CMD check. See .agents/design.md §9 and §17 D4.
set -eu

SVG_TAG="${1:?usage: tools/update-plutosvg <plutosvg-tag> <plutovg-tag>}"
VG_TAG="${2:?usage: tools/update-plutosvg <plutosvg-tag> <plutovg-tag>}"
ROOT=$(pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# fetch <name> <tag>: download, hash and unpack one library; sets
# <NAME>_URL, <NAME>_SHA, <NAME>_COMMIT and <NAME>_SRC.
fetch() {
  name=$1
  tag=$2
  repo="https://github.com/sammycage/${name}"
  url="${repo}/archive/refs/tags/${tag}.tar.gz"
  # An annotated tag lists its peeled commit as <tag>^{}; sort puts it last.
  commit=$(git ls-remote --tags "$repo" "refs/tags/${tag}" "refs/tags/${tag}^{}" |
    sort -k2 | tail -1 | cut -f1)
  [ -n "$commit" ] || { echo "tag ${tag} not found in ${repo}" >&2; exit 1; }
  echo "==> fetching $url" >&2
  curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused \
    -o "$WORK/${name}.tar.gz" "$url"
  sha=$(shasum -a 256 "$WORK/${name}.tar.gz" | cut -d' ' -f1)
  mkdir "$WORK/${name}"
  tar xzf "$WORK/${name}.tar.gz" -C "$WORK/${name}"
  echo "$url $sha $commit $WORK/${name}/${name}-${tag#v}"
}

set -- $(fetch plutosvg "$SVG_TAG")
SVG_URL=$1 SVG_SHA=$2 SVG_COMMIT=$3 SVG_SRC=$4
set -- $(fetch plutovg "$VG_TAG")
VG_URL=$1 VG_SHA=$2 VG_COMMIT=$3 VG_SRC=$4

echo "==> replacing src/vendor/plutosvg and src/vendor/plutovg"
for lib in plutosvg plutovg; do
  case $lib in plutosvg) src=$SVG_SRC ;; *) src=$VG_SRC ;; esac
  rm -rf "$ROOT/src/vendor/$lib"
  grep -v '^#' "$ROOT/tools/${lib}-files.txt" | grep -v '^[[:space:]]*$' |
    while read -r f; do
      mkdir -p "$ROOT/src/vendor/$lib/$(dirname "$f")"
      cp "$src/$f" "$ROOT/src/vendor/$lib/$f"
    done
done

PATCHES=""
PATCH_IDS=""
for p in "$ROOT"/tools/patches/*.patch; do
  [ -f "$p" ] || continue
  b=$(basename "$p")
  echo "==> applying $b"
  patch -s -p1 -d "$ROOT/src/vendor" < "$p"
  PATCHES="${PATCHES}                 ${b}
"
  PATCH_IDS="${PATCH_IDS:+$PATCH_IDS,}${b%.patch}"
done
find "$ROOT/src/vendor" \( -name '*.orig' -o -name '*.rej' \) -delete

echo "==> writing src/zsg_vendor.h"
cat > "$ROOT/src/zsg_vendor.h" <<HEOF
/* Written by tools/update-plutosvg; do not edit. tools/verify-vendor fails
 * if it disagrees with src/vendor/PROVENANCE. */
#ifndef ZSG_VENDOR_H
#define ZSG_VENDOR_H

#define ZSG_PLUTOSVG_TAG "${SVG_TAG}"
#define ZSG_PLUTOSVG_COMMIT "${SVG_COMMIT}"
#define ZSG_PLUTOVG_TAG "${VG_TAG}"
#define ZSG_PLUTOVG_COMMIT "${VG_COMMIT}"
#define ZSG_PATCHES "${PATCH_IDS}"

#endif
HEOF

echo "==> writing src/vendor/PROVENANCE"
cat > "$ROOT/src/vendor/PROVENANCE" <<PEOF
Vendored dependencies: plutosvg and plutovg

plutosvg
  Upstream:      https://github.com/sammycage/plutosvg
  Release tag:   ${SVG_TAG}
  Commit:        ${SVG_COMMIT}
  Archive:       ${SVG_URL}
  SHA-256:       ${SVG_SHA}
  License:       MIT (src/vendor/plutosvg/LICENSE)

plutovg
  Upstream:      https://github.com/sammycage/plutovg
  Release tag:   ${VG_TAG}
  Commit:        ${VG_COMMIT}
  Archive:       ${VG_URL}
  SHA-256:       ${VG_SHA}
  License:       MIT (src/vendor/plutovg/LICENSE); the FreeType-derived
                 plutovg-ft-*.{c,h} under the FreeType Licence
                 (src/vendor/plutovg/source/FTL.TXT); the stb headers
                 public domain or MIT, at the end of each file

  Imported:      $(date -u +%Y-%m-%d)
  Local patches: applied in this order, from tools/patches/
${PATCHES}
src/vendor/plutosvg/ and src/vendor/plutovg/ are the files listed in
tools/plutosvg-files.txt and tools/plutovg-files.txt, copied from the
archives to the same relative paths, with exactly the patches above
applied. tools/verify-vendor re-derives both trees from the pinned archives
and the patch series and fails on any other difference. Every patch is
minimal and offered upstream; each is named in zusvg_info().

Left out: plutosvg-ft.h (compiled only under PLUTOSVG_HAS_FREETYPE), CMake,
Meson, the tests, the examples and the images. Compile configuration, in
src/Makevars, with the reason for each there: PLUTOVG_BUILD_STATIC and
PLUTOSVG_BUILD_STATIC (never the *_BUILD macros, which export the API past
\$(C_VISIBILITY)); STBIDEF, STBIWDEF and STBTT_DEF set to extern (hidden);
PLUTOVG_DISABLE_FONT_FACE_CACHE_LOAD; STBI_NO_* for every image format but
PNG and JPEG; STBI_NO_THREAD_LOCALS; HAVE_THREADS_H and
PLUTOSVG_HAS_FREETYPE undefined. R's -DNDEBUG removes the vendored
assert()s in an installed build.

GitHub publishes no uploaded release asset for these tags, so each archive
is the one GitHub generates from the tag. Hash verification is
trust-on-first-use: the SHA-256s above were computed at import time and are
re-checked by tools/verify-vendor. If GitHub ever regenerates an archive
with different bytes, verification fails, and the new archive must be
compared against the recorded commit before the digest is updated.

$(cat "$ROOT/tools/vendor-warnings.txt")
PEOF

echo "==> done. Next: tools/verify-vendor, tools/check-symbols, R CMD check."
