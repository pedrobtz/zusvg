#!/bin/sh
# Prove tools/patches/0001-use-depth.patch is load-bearing (.agents/design.md
# §9, §17 D4): a chain of distinct <use> elements, each pointing at the one
# before, must crash the unpatched plutosvg (C stack overflow) and render
# with the patch, which stops it at MAX_RENDER_DEPTH.
#
# Builds a small driver twice, against src/vendor/ as committed and against
# upstream as released (every patch reversed: later patches touch the same
# function, so 0001 alone cannot be), renders the same generated document with each
# under an 8 MiB stack, and fails unless the first succeeds and the second
# dies by a signal. Run from the package root, after tools/verify-vendor.
#
# Usage: tools/check-use-chain [hops]   (default 200000)
set -eu

HOPS="${1:-200000}"
CC=$(R CMD config CC)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# The document: u0 is a rect, u<i> uses u<i-1>, and the root uses the last.
awk -v n="$HOPS" 'BEGIN {
  print "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\"><defs>"
  print "<rect id=\"u0\" width=\"16\" height=\"16\" fill=\"#00f\"/>"
  for (i = 1; i <= n; i++) printf "<use id=\"u%d\" href=\"#u%d\"/>\n", i, i - 1
  printf "</defs><use href=\"#u%d\"/></svg>\n", n
}' > "$WORK/chain.svg"

cat > "$WORK/driver.c" <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <plutosvg.h>

/* Exit 0 if the document renders, 2 if it does not load, 3 if it does not
 * render; a stack overflow ends the process with a signal instead. */
int main(int argc, char **argv)
{
    FILE *f = fopen(argv[1], "rb");
    if (f == NULL)
        return 4;
    fseek(f, 0, SEEK_END);
    long n = ftell(f);
    fseek(f, 0, SEEK_SET);
    char *buf = malloc((size_t) n);
    if (buf == NULL || fread(buf, 1, (size_t) n, f) != (size_t) n)
        return 4;
    fclose(f);
    plutosvg_document_t *doc =
        plutosvg_document_load_from_data(buf, (int) n, -1, -1, free, buf);
    if (doc == NULL)
        return 2;
    plutovg_surface_t *s =
        plutosvg_document_render_to_surface(doc, NULL, -1, -1, NULL, NULL, NULL);
    plutosvg_document_destroy(doc);
    if (s == NULL)
        return 3;
    plutovg_surface_destroy(s);
    (void) argc;
    return 0;
}
EOF

# build <vendor-dir> <out>
build() {
  $CC -O1 -o "$2" -I"$1/plutovg/include" -I"$1/plutosvg/source" \
    -DPLUTOVG_BUILD_STATIC -DPLUTOSVG_BUILD_STATIC \
    -DPLUTOVG_DISABLE_FONT_FACE_CACHE_LOAD \
    "$WORK/driver.c" "$1"/plutosvg/source/plutosvg.c "$1"/plutovg/source/*.c -lm
}

cp -R src/vendor "$WORK/unpatched"
find "$WORK/unpatched" \( -name '*.o' -o -name '*.so' \) -delete
for p in $(ls tools/patches/*.patch | sort -r); do
  patch -s -R -p1 -d "$WORK/unpatched" < "$p"
done

echo "==> building the driver against src/vendor and against upstream as released"
build src/vendor "$WORK/patched"
build "$WORK/unpatched" "$WORK/unpatched-driver"

# run <binary>: the exit status under an 8 MiB stack, the common default.
run() {
  ( ulimit -s 8192; "$1" "$WORK/chain.svg" ) >/dev/null 2>&1 && echo 0 || echo $?
}

status=0
patched=$(run "$WORK/patched")
unpatched=$(run "$WORK/unpatched-driver")
echo "==> $HOPS-hop <use> chain: patched exit $patched, unpatched exit $unpatched"
if [ "$patched" != 0 ]; then
  echo "FAIL: the patched build did not render the chain (exit $patched)" >&2
  status=1
fi
if [ "$unpatched" -le 128 ]; then
  echo "FAIL: the unpatched build did not crash (exit $unpatched); raise the hop count" >&2
  status=1
fi
[ "$status" -eq 0 ] && echo "==> 0001-use-depth is load-bearing"
exit "$status"
