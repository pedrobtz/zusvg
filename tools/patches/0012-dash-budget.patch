Subject: Bound the dash segments of a path, and stop when a dash cannot advance

dash_traverse_func() emits one segment per dash with no bound, so a long
path with a short dash pattern -- a 44-billion-pixel rectangle dashed
"4 2", found by zusvg's fuzzer -- grows the output path until memory runs
out. In single precision a dash smaller than the path length's ulp no
longer advances dist1, so the loop also never ends; and the int dash index
overflows (undefined behaviour) on a long enough path.

Give each dashed traversal a budget of PLUTOVG_MAX_DASH_SEGMENTS (one
million) segments; when it is spent, or when a dash would not advance, the
rest of the path is drawn solid. Keep the dash index modulo ndashes.
Dashing within the budget is unchanged.

zusvg: .agents/design.md §9. Offered upstream.

--- a/plutovg/source/plutovg-path.c
+++ b/plutovg/source/plutovg-path.c
@@ -531,8 +531,13 @@
     plutovg_point_t current_point;
     plutovg_path_traverse_func_t traverse_func;
     void* closure;
+    long budget;
 } dasher_t;
 
+/* The most dash segments one path makes; past it, and wherever a dash is
+ * too small to advance in single precision, the rest is drawn solid. */
+#define PLUTOVG_MAX_DASH_SEGMENTS 1000000L
+
 static void dash_traverse_func(void* closure, plutovg_path_command_t command, const plutovg_point_t* points, int npoints)
 {
     dasher_t* dasher = (dasher_t*)(closure);
@@ -554,7 +559,15 @@
     float dist0 = sqrtf(dx*dx + dy*dy);
     float dist1 = 0.f;
     while(dist0 - dist1 > dasher->dashes[dasher->index % dasher->ndashes] - dasher->phase) {
-        dist1 += dasher->dashes[dasher->index % dasher->ndashes] - dasher->phase;
+        float next = dist1 + dasher->dashes[dasher->index % dasher->ndashes] - dasher->phase;
+        if(dasher->budget <= 0 || !(next > dist1)) {
+            dasher->budget = 0;
+            dasher->toggle = true;
+            break;
+        }
+
+        dasher->budget--;
+        dist1 = next;
         float a = dist1 / dist0;
         plutovg_point_t p = { p0.x + a * dx, p0.y + a * dy };
         if(dasher->toggle) {
@@ -565,7 +578,7 @@
 
         dasher->phase = 0.f;
         dasher->toggle = !dasher->toggle;
-        dasher->index++;
+        dasher->index = (dasher->index + 1) % dasher->ndashes;
     }
 
     if(dasher->toggle) {
@@ -608,6 +621,7 @@
     dasher.current_point = PLUTOVG_EMPTY_POINT;
     dasher.traverse_func = traverse_func;
     dasher.closure = closure;
+    dasher.budget = PLUTOVG_MAX_DASH_SEGMENTS;
     plutovg_path_traverse_flatten(path, dash_traverse_func, &dasher);
 }
 
