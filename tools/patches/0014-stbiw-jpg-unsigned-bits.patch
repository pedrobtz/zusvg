Subject: Shift the JPEG bit buffer as unsigned

stbiw__jpg_writeBits() shifts a signed int bit buffer left by 8 after each
byte it writes, so bits above bit 23 pile up and the shift overflows --
undefined behaviour, reported by UBSan on every JPEG zusvg's tests encode
("left shift of 16052224 by 8 places cannot be represented in type
'int'"). Only bits 0-23 are ever read. Do the arithmetic unsigned and keep
24 bits; the bytes written are unchanged.

zusvg: .agents/design.md §7. Offered upstream.

--- a/plutovg/source/plutovg-stb-image-write.h
+++ b/plutovg/source/plutovg-stb-image-write.h
@@ -1251,9 +1251,10 @@
       24,31,40,44,53,10,19,23,32,39,45,52,54,20,22,33,38,46,51,55,60,21,34,37,47,50,56,59,61,35,36,48,49,57,58,62,63 };
 
 static void stbiw__jpg_writeBits(stbi__write_context *s, int *bitBufP, int *bitCntP, const unsigned short *bs) {
-   int bitBuf = *bitBufP, bitCnt = *bitCntP;
+   unsigned int bitBuf = (unsigned int) *bitBufP;
+   int bitCnt = *bitCntP;
    bitCnt += bs[1];
-   bitBuf |= bs[0] << (24 - bitCnt);
+   bitBuf |= (unsigned int) bs[0] << (24 - bitCnt);
    while(bitCnt >= 8) {
       unsigned char c = (bitBuf >> 16) & 255;
       stbiw__putc(s, c);
@@ -1263,7 +1264,7 @@
       bitBuf <<= 8;
       bitCnt -= 8;
    }
-   *bitBufP = bitBuf;
+   *bitBufP = (int) (bitBuf & 0xFFFFFFu);
    *bitCntP = bitCnt;
 }
 
