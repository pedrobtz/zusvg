#!/bin/sh
# Project C code compiles warning-free under strict flags (roadmap Stage 5).
# The vendored libraries are not held to this; PROVENANCE records their
# warnings. The check first compiles a planted warning and requires it to
# fail, since -fsyntax-only alone exits 0 on warnings: a gate is trusted once
# it has been seen to fail. Run from the package root.
set -eu

CC=${CC:-cc}
. tools/fuzz-env
RINC=$(Rscript -e 'cat(R.home("include"))')
FLAGS="-std=gnu17 -DNDEBUG -Wall -Wextra -Wpedantic -Wshadow -Wstrict-prototypes -Werror -fsyntax-only"
# R's, zufast's and the vendored headers are -isystem: the gate is for
# zusvg's code. R 4.6's R_ext/Boolean.h uses a C23 enum form -Wpedantic
# rejects in gnu17.
INC="-isystem $RINC -isystem $ZUFAST_INC -Isrc -isystem src/vendor/plutovg/include -isystem src/vendor/plutosvg/source"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

printf 'int zsg_lint_canary(void) { int unused; return 0; }\n' > "$WORK/canary.c"
if $CC $FLAGS "$WORK/canary.c" 2>/dev/null; then
  echo "FAIL: the lint gate accepted a planted warning" >&2
  exit 2
fi

fail=0
for f in src/*.c fuzz/*.c; do
  extra=""
  # init.c casts each entry point to DL_FUNC, the registration idiom Writing
  # R Extensions prescribes; -Wextra's function-cast check rejects it.
  [ "$f" = src/init.c ] && extra="-Wno-cast-function-type -Wno-unknown-warning-option -Wno-cast-function-type-mismatch"
  $CC $FLAGS $extra $ZSG_DEFS $INC "$f" || fail=1
done
[ $fail = 0 ] || { echo "FAIL: warnings in project C code" >&2; exit 1; }
echo "==> project C code is warning-free under $FLAGS"
